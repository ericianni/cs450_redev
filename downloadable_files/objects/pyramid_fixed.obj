# Triangulated Square-Based Pyramid with UVs and Normals
# 5 Vertices (4 base corners, 1 apex)
v 0.000000 -0.500000 -1.000000
v 1.000000 -0.500000 0.000000
v -0.000000 -0.500000 1.000000
v -1.000000 -0.500000 -0.000000
v 0.000000 0.500000 0.000000

# 5 Texture Coordinates (UVs)
# Used for the square base and the triangular sides
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.5 1.0

# 5 Face Normals
vn  0.0000 -1.0000  0.0000
vn  0.0000  0.4472  0.8944
vn  0.8944  0.4472  0.0000
vn  0.0000  0.4472 -0.8944
vn -0.8944  0.4472  0.0000

# 6 Triangulated Faces (Format: vertex/texture/normal)

# Bottom Face / Base (2 Triangles, mapped to full 0-1 UV square)
f 1/1/1 4/4/1 3/3/1
f 1/1/1 3/3/1 2/2/1

# Front Face (1 Triangle, mapped to a triangle in UV space)
f 1/1/2 2/2/2 5/5/2

# Right Face (1 Triangle)
f 2/1/3 3/2/3 5/5/3

# Back Face (1 Triangle)
f 3/1/4 4/2/4 5/5/4

# Left Face (1 Triangle)
f 4/1/5 1/2/5 5/5/5